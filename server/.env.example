PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/otp-auth
NODE_ENV=

# Email provider: "gmail" (local dev) or "brevo" (production)
EMAIL_PROVIDER=

# Gmail (EMAIL_PROVIDER=gmail) - EMAIL_PASS is a Gmail App Password
EMAIL_USER=
EMAIL_PASS=

# Brevo (EMAIL_PROVIDER=brevo) - EMAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=
EMAIL_FROM=

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/otp-auth
NODE_ENV=

# Long random string used to sign login tokens (JWT), at least 32 characters
JWT_SECRET=

# Optional. How many proxies sit in front of Express (for the real client IP).
# Leave empty locally (= 0). Set it at deploy time after checking the headers.
TRUST_PROXY=

# Email provider: "gmail" (local dev) or "brevo" (production)
EMAIL_PROVIDER=

# Gmail (EMAIL_PROVIDER=gmail) - EMAIL_PASS is a Gmail App Password
EMAIL_USER=
EMAIL_PASS=

# Brevo (EMAIL_PROVIDER=brevo) - EMAIL_FROM must be a verified sender in Brevo
BREVO_API_KEY=
EMAIL_FROM=
